# =============================================================
# PR Guardian — Local Development Environment
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================

# ----- Database -----
DATABASE_URL=postgresql://prguardian:prguardian_dev@localhost:5432/prguardian

# ----- API server -----
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ----- Feature flags -----
# Keep DEMO_MODE_ENABLED=true — recruiter demo must always work without credentials
DEMO_MODE_ENABLED=true
AI_REVIEW_ENABLED=false
LIVE_GITHUB_ENABLED=false
STATIC_ANALYSIS_ENABLED=true
GITHUB_PUBLISH_ENABLED=false
LIVE_REVIEW_RATE_LIMIT_ENABLED=true
COST_LIMIT_ENFORCED=true

# ----- Rate limiting -----
RATE_LIMIT_DEMO_RPM=60
RATE_LIMIT_AUTH_ATTEMPTS=10

# ----- Web / CORS (dev only — leave unset in production) -----
# API_CORS_ORIGIN allows the Vite dev server (port 5173) to call the API (port 3001).
# Unset in production — reverse proxy serves both from the same origin.
API_CORS_ORIGIN=http://localhost:5173

# ----- Frontend (Vite env vars — prefix VITE_ to expose to browser) -----
VITE_API_BASE_URL=http://localhost:3001

# ----- Worker -----
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=120
WORKER_JOB_TIMEOUT_SECONDS=600

# ----- Sessions (required for M2 auth) -----
SESSION_SECRET=change_me_to_a_random_32plus_char_string_here
SESSION_TTL_SECONDS=604800

# ----- GitHub OAuth (required for M2 auth — fill in from GitHub App settings) -----
GITHUB_CLIENT_ID=your_github_app_client_id_here
GITHUB_CLIENT_SECRET=your_github_app_client_secret_here
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:5173/auth/callback
GITHUB_APP_ID=

# ----- Frontend (Vite env var — set your GitHub App slug for the install URL) -----
VITE_GITHUB_APP_NAME=your_github_app_slug_here

# ----- GitHub App keys (required for M3 webhooks) -----
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_API_VERSION=2022-11-28

# ----- AI Provider (fill in when AI_REVIEW_ENABLED=true in M5) -----
# AI_PROVIDER=anthropic
# AI_MODEL_ID=claude-sonnet-4-6
# AI_API_KEY=
# AI_MAX_INPUT_TOKENS=50000
# AI_MAX_OUTPUT_TOKENS=4096
# AI_MAX_COST_USD_PER_REVIEW=0.05

# ----- Docker Compose only -----
# POSTGRES_USER=prguardian
# POSTGRES_PASSWORD=prguardian_dev
# POSTGRES_DB=prguardian
