generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstallationStatus {
  active
  removed
}

enum ReviewJobStatus {
  pending
  running
  succeeded
  failed
}

model User {
  id             String   @id @default(uuid())
  githubUserId   BigInt   @unique @map("github_user_id")
  githubUsername String   @map("github_username")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions                Session[]
  repositories            Repository[]
  repositoryInstallations RepositoryInstallation?[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Repository {
  id                   String   @id @default(uuid())
  githubRepositoryId   BigInt   @unique @map("github_repository_id")
  githubInstallationId BigInt   @map("github_installation_id")
  owner                String
  name                 String
  fullName             String   @map("full_name")
  isActive             Boolean  @default(true) @map("is_active")
  ownedByUserId        String?  @map("owned_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  ownerUser User? @relation(fields: [ownedByUserId], references: [id])

  @@index([githubInstallationId])
  @@index([ownedByUserId])
  @@map("repositories")
}

model RepositoryInstallation {
  id                   String             @id @default(uuid())
  githubInstallationId BigInt             @unique @map("github_installation_id")
  githubAccountId      BigInt             @map("github_account_id")
  githubAccountLogin   String             @map("github_account_login")
  createdByUserId      String?            @map("created_by_user_id")
  status               InstallationStatus @default(active)
  installedAt          DateTime           @map("installed_at")
  removedAt            DateTime?          @map("removed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  createdByUser User? @relation(fields: [createdByUserId], references: [id])

  @@index([githubAccountId])
  @@index([createdByUserId])
  @@map("repository_installations")
}

model WebhookDelivery {
  id               String   @id @default(uuid())
  githubDeliveryId String   @unique @map("github_delivery_id")
  event            String
  action           String?
  receivedAt       DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@map("webhook_deliveries")
}

model ReviewJob {
  id             String          @id @default(uuid())
  status         ReviewJobStatus @default(pending)
  installationId BigInt          @map("installation_id")
  repositoryId   BigInt          @map("repository_id")
  prNumber       Int             @map("pr_number")
  headSha        String          @map("head_sha")
  attempts       Int             @default(0)
  maxAttempts    Int             @default(3) @map("max_attempts")
  leaseExpiresAt DateTime?       @map("lease_expires_at")
  errorMessage   String?         @map("error_message")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  completedAt    DateTime?       @map("completed_at")

  @@index([status, leaseExpiresAt])
  @@index([createdAt])
  @@map("review_jobs")
}
