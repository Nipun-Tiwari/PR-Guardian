generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  githubUserId   BigInt   @unique @map("github_user_id")
  githubUsername String   @map("github_username")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions     Session[]
  repositories Repository[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Repository {
  id                   String   @id @default(uuid())
  githubRepositoryId   BigInt   @unique @map("github_repository_id")
  githubInstallationId BigInt   @map("github_installation_id")
  owner                String
  name                 String
  fullName             String   @map("full_name")
  isActive             Boolean  @default(true) @map("is_active")
  ownedByUserId        String   @map("owned_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  ownerUser User @relation(fields: [ownedByUserId], references: [id])

  @@index([githubInstallationId])
  @@index([ownedByUserId])
  @@map("repositories")
}
