{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "db:generate": {
      "outputs": ["src/generated/**"]
    },
    "db:migrate": {
      "dependsOn": ["db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
